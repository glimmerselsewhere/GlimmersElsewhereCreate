  ],
  "scenes": [
    {
      "id": "scene-01",
      "chapter": "Stage 1",
      "title": "Gray Blanket Town",
      "description": "Naptime sun is gone. Xiaonuan's crooked red cloak and fish badge hold a tiny glow.",
      "image": "assets/images/scenes/scene-01.png",
      "actions": [
        {
          "id": "a1",
          "name": "Push the door open",
          "hint": "one step out",
          "icon": "A"
        },
        {
          "id": "a2",
          "name": "Tap a neighbor",
          "hint": "wake someone",
          "icon": "B"
        },
        {
          "id": "a3",
          "name": "Hide in the quilt",
          "hint": "hide a bit",
          "icon": "C"
        }
      ],
      "outcomes": {
        "a1": {
          "text": "Cold wind rushes in, but paws step out first.",
          "stateChanges": {
            "courage": 1
          },
          "image": "assets/images/outcomes/scene-01-a1.png"
        },
        "a2": {
          "text": "A note says: napping, do not disturb.",
          "stateChanges": {
            "bond": 1
          },
          "image": "assets/images/outcomes/scene-01-a2.png"
        },
        "a3": {
          "text": "The quilt is soft, but the dark still creeps in.",
          "stateChanges": {
            "courage": -1
          },
          "image": "assets/images/outcomes/scene-01-a3.png"
        }
      }
    },
    {
      "id": "scene-02",
      "chapter": "Stage 2",
      "title": "The Bell Path",
      "description": "A sleepy bespectacled sparrow nudges a tiny bell toward you.",
      "image": "assets/images/scenes/scene-02.png",
      "actions": [
        {
          "id": "a1",
          "name": "Wear the little bell",
          "hint": "light the way",
          "icon": "A"
        },
        {
          "id": "a2",
          "name": "Ask the sparrow",
          "hint": "ask the way",
          "icon": "B"
        },
        {
          "id": "a3",
          "name": "Sneak around it",
          "hint": "stay unseen",
          "icon": "C"
        }
      ],
      "outcomes": {
        "a1": {
          "text": "One jingle, and the path looks clearer.",
          "stateChanges": {
            "wit": 1
          },
          "image": "assets/images/outcomes/scene-02-a1.png"
        },
        "a2": {
          "text": "It says: follow the bone-scented wind.",
          "stateChanges": {
            "bond": 1
          },
          "image": "assets/images/outcomes/scene-02-a2.png"
        },
        "a3": {
          "text": "You dodge it, and the path loops back.",
          "stateChanges": {
            "courage": -1
          },
          "image": "assets/images/outcomes/scene-02-a3.png"
        }
      }
    },
    {
      "id": "scene-03",
      "chapter": "Stage 3",
      "title": "Yarn Forest",
      "description": "Colored yarn wraps the trees. A ball of wool rolls toward darker woods.",
      "image": "assets/images/scenes/scene-03.png",
      "actions": [
        {
          "id": "a1",
          "name": "Follow the yarn ball",
          "hint": "follow the thread",
          "icon": "A"
        },
        {
          "id": "a2",
          "name": "Weave a yarn bridge",
          "hint": "build a path",
          "icon": "B"
        },
        {
          "id": "a3",
          "name": "Hug it and nap",
          "hint": "rest first",
          "icon": "C"
        }
      ],
      "outcomes": {
        "a1": {
          "text": "The yarn leads you past drowsy trees.",
          "stateChanges": {
            "courage": 1
          },
          "image": "assets/images/outcomes/scene-03-a1.png"
        },
        "a2": {
          "text": "The wobbly yarn bridge crosses the puddle.",
          "stateChanges": {
            "wit": 1
          },
          "image": "assets/images/outcomes/scene-03-a2.png"
        },
        "a3": {
          "text": "You wake: the yarn is gone, only cold dew.",
          "stateChanges": {
            "courage": -1
          },
          "image": "assets/images/outcomes/scene-03-a3.png"
        }
      }
    },
    {
      "id": "scene-04",
      "chapter": "Stage 4",
      "title": "Cushion Moat",
      "description": "A river of cushions. Guard-dog snores make them rise and sink.",
      "image": "assets/images/scenes/scene-04.png",
      "actions": [
        {
          "id": "a1",
          "name": "Hop the cushions",
          "hint": "just jump",
          "icon": "A"
        },
        {
          "id": "a2",
          "name": "Ring them awake",
          "hint": "wake the guards",
          "icon": "B"
        },
        {
          "id": "a3",
          "name": "Float on a cushion",
          "hint": "drift across",
          "icon": "C"
        }
      ],
      "outcomes": {
        "a1": {
          "text": "Cushions squeak, but you land on the far bank.",
          "stateChanges": {
            "courage": 1
          },
          "image": "assets/images/outcomes/scene-04-a1.png"
        },
        "a2": {
          "text": "A groggy guard points to a side door, then naps.",
          "stateChanges": {
            "wit": 1,
            "bond": 1
          },
          "image": "assets/images/outcomes/scene-04-a2.png"
        },
        "a3": {
          "text": "The cushion spins you back to where you started.",
          "stateChanges": {
            "courage": -1
          },
          "image": "assets/images/outcomes/scene-04-a3.png"
        }
      }
    },
    {
      "id": "scene-05",
      "chapter": "Stage 5",
      "title": "The Bone Bell",
      "description": "A spotted hound rubs its eyes and asks what you came to claim.",
      "image": "assets/images/scenes/scene-05.png",
      "actions": [
        {
          "id": "a1",
          "name": "Ask for sunshine",
          "hint": "say it plainly",
          "icon": "A"
        },
        {
          "id": "a2",
          "name": "Show the fish badge",
          "hint": "show the token",
          "icon": "B"
        },
        {
          "id": "a3",
          "name": "Ask about the castle",
          "hint": "listen first",
          "icon": "C"
        }
      ],
      "outcomes": {
        "a1": {
          "text": "The hound blinks. The side door creaks open.",
          "stateChanges": {
            "courage": 1
          },
          "image": "assets/images/outcomes/scene-05-a1.png"
        },
        "a2": {
          "text": "A warm flash. He lets you pat his head and enter.",
          "stateChanges": {
            "wit": 1,
            "bond": 1
          },
          "image": "assets/images/outcomes/scene-05-a2.png"
        },
        "a3": {
          "text": "He says the king fears sunburn, so the light was jarred.",
          "stateChanges": {
            "bond": 1
          },
          "image": "assets/images/outcomes/scene-05-a3.png"
        }
      }
    },
    {
      "id": "scene-06",
      "chapter": "Stage 6",
      "title": "Hall of Snores",
      "description": "Bone pillows everywhere. A jar of gold light pulses at the far end.",
      "image": "assets/images/scenes/scene-06.png",
      "actions": [
        {
          "id": "a1",
          "name": "Walk to the jar",
          "hint": "go straight",
          "icon": "A"
        },
        {
          "id": "a2",
          "name": "Lasso the lid",
          "hint": "trick the lid",
          "icon": "B"
        },
        {
          "id": "a3",
          "name": "Tidy the pillows",
          "hint": "make a path",
          "icon": "C"
        }
      ],
      "outcomes": {
        "a1": {
          "text": "The floor creaks, yet you reach the light.",
          "stateChanges": {
            "courage": 1
          },
          "image": "assets/images/outcomes/scene-06-a1.png"
        },
        "a2": {
          "text": "A gentle tug, and the lid loosens a half turn.",
          "stateChanges": {
            "wit": 1
          },
          "image": "assets/images/outcomes/scene-06-a2.png"
        },
        "a3": {
          "text": "The pillows happily open a soft aisle.",
          "stateChanges": {
            "bond": 1
          },
          "image": "assets/images/outcomes/scene-06-a3.png"
        }
      }
    },
    {
      "id": "scene-07",
      "chapter": "Stage 7",
      "title": "The Shivering King",
      "description": "A round short-legged dog hugs the jar. His ears are trembling.",
      "image": "assets/images/scenes/scene-07.png",
      "actions": [
        {
          "id": "a1",
          "name": "Claim the sunshine",
          "hint": "ask it back",
          "icon": "A"
        },
        {
          "id": "a2",
          "name": "Shake the bell",
          "hint": "soothe the king",
          "icon": "B"
        },
        {
          "id": "a3",
          "name": "Sit and listen",
          "hint": "hear him out",
          "icon": "C"
        }
      ],
      "outcomes": {
        "a1": {
          "text": "Your cloak is crooked, but your voice is steady.",
          "stateChanges": {
            "courage": 2
          },
          "image": "assets/images/outcomes/scene-07-a1.png"
        },
        "a2": {
          "text": "The bell eases him. His paws loosen a little.",
          "stateChanges": {
            "wit": 1,
            "bond": 1
          },
          "image": "assets/images/outcomes/scene-07-a2.png"
        },
        "a3": {
          "text": "He says the sun stings, so hiding it lets all nap.",
          "stateChanges": {
            "bond": 2
          },
          "image": "assets/images/outcomes/scene-07-a3.png"
        }
      }
    },
    {
      "id": "scene-08",
      "chapter": "Stage 8",
      "title": "The Bone Jar",
      "description": "A whole afternoon sits in the jar. Badge warm, king's nose shining.",
      "image": "assets/images/scenes/scene-08.png",
      "actions": [
        {
          "id": "a1",
          "name": "Tip the jar over",
          "hint": "set light free",
          "icon": "A"
        },
        {
          "id": "a2",
          "name": "Suggest nap shifts",
          "hint": "share the sun",
          "icon": "B"
        },
        {
          "id": "a3",
          "name": "Ask a spoonful",
          "hint": "just a little",
          "icon": "C"
        }
      ],
      "outcomes": {
        "a1": {
          "text": "Gold light spills like warm milk across the floor.",
          "stateChanges": {
            "courage": 1
          },
          "image": "assets/images/outcomes/scene-08-a1.png"
        },
        "a2": {
          "text": "Two paws sketch a shift chart on the lid.",
          "stateChanges": {
            "wit": 1,
            "bond": 1
          },
          "image": "assets/images/outcomes/scene-08-a2.png"
        },
        "a3": {
          "text": "He scoops you a spoon of light, keeping the shade.",
          "stateChanges": {
            "bond": 1
          },
          "image": "assets/images/outcomes/scene-08-a3.png"
        }
      }
    }
  ],
  "endings": [
    {
      "id": "ending-hero",
      "title": "Sunshine, One Paw at a Time",
      "description": "Xiaonuan tips the jar. Warm light floods the town. The dog king sneezes gold. The timid cat stands in the sun, cloak still crooked.",
      "all": [
        {
          "state": "courage",
          "operator": ">=",
          "value": 8
        }
      ],
      "image": "assets/images/endings/ending-hero.png"
    },
    {
      "id": "ending-friends",
      "title": "The Nap-Shift Pact",
      "description": "Xiaonuan hears his fear of sunburn. Light is split: one share for town, one for a sleepy nose. The bell will call the shift change.",
      "all": [
        {
          "state": "bond",
          "operator": ">=",
          "value": 6
        }
      ],
      "image": "assets/images/endings/ending-friends.png"
    },
    {
      "id": "ending-ordinary",
      "title": "A Spoonful of Afternoon",
      "description": "Only a spoon of afternoon comes home. The badge warms the road; a windowsill glows. The castle still snores, but the dark is less full.",
      "all": [],
      "image": "assets/images/endings/ending-ordinary.png"
    }
  ],
