{
  "id": "cat-hero-dog-king",
  "title": "The Cat Hero and the Dog Demon King",
  "shortTitle": "The Cat Hero and the Dog Demon King",
  "subtitle": "One paw at a time, bring the sunshine home",
  "description": "A timid orange cat sets out to reclaim the naptime sunshine hidden in the dog demon king's castle. No claws draw blood—only cushions, bells, and a wish to wake the town gently.",
  "mode": null,
